# Copy to backend/.env and adjust. Never commit real secrets.

DATABASE_URL=postgresql+psycopg://reschat:reschat@127.0.0.1:5433/reschatbot
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Assistant -------------------------------------------------------------
# true  = deterministic demo mode, never calls an LLM (no key needed)
# false = use the LLM for intent parsing + wording when a key is configured
#         (without a key it still falls back to deterministic mode)
ASSISTANT_DEMO_MODE=false
# groq (default) | xai (Grok) | anthropic (Claude) | none
LLM_PROVIDER=groq
# Empty = provider default (groq: openai/gpt-oss-120b, xai: grok-4, anthropic: claude-opus-5-5)
LLM_MODEL=openai/gpt-oss-120b
# Model for rewording replies; empty = same as LLM_MODEL. A second model gets
# its own per-model rate limit on Groq's free tier.
LLM_COMPOSE_MODEL=qwen/qwen3.8-27b
# Sent to Groq/xAI as reasoning_effort (empty = omit)
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=20
GROQ_API_KEY=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_EFFORT=low
LLM_REFUSAL_FALLBACK=true

# --- Rate limiting (per client IP, per minute) -----------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_SEARCH_PER_MINUTE=60
# Only enable behind a proxy you control (it trusts X-Forwarded-For).
TRUST_PROXY_HEADERS=false

# Enables /api/onboarding/* when set. Use a long random value.
ADMIN_API_KEY=
